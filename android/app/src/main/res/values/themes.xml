<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.PocketLink" parent="android:Theme.DeviceDefault.DayNight">
        <item name="android:colorAccent">#7847D8</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
    <style name="Theme.PocketLink.Clip" parent="android:Theme.DeviceDefault.DayNight">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
    <style name="Theme.PocketLink.Blue" parent="Theme.PocketLink"><item name="android:colorAccent">#3268D9</item></style>
    <style name="Theme.PocketLink.Green" parent="Theme.PocketLink"><item name="android:colorAccent">#187C61</item></style>
    <style name="Theme.PocketLink.Orange" parent="Theme.PocketLink"><item name="android:colorAccent">#B75B19</item></style>
    <style name="Theme.PocketLink.Pink" parent="Theme.PocketLink"><item name="android:colorAccent">#B63D76</item></style>
    <style name="Theme.PocketLink.Graphite" parent="Theme.PocketLink"><item name="android:colorAccent">#536173</item></style>
</resources>
